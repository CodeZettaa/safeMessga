# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only fallback if NEXT_PUBLIC_SUPABASE_URL was missing at build time.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Server-only. Never expose this in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Privacy-preserving sender hashing. Use a long random string.
# The raw IP is hashed with this salt and never stored.
SENDER_HASH_SALT=replace-with-a-long-random-secret

# Optional extra check: only this email may use the admin dashboard.
# Still add the user to public.admin_users after creating them in Auth.
ADMIN_EMAIL=you@example.com

# Optional external moderation. Leave unset to use the local layer only.
# MODERATION_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODERATION_MODEL=omni-moderation-latest

# Optional CAPTCHA (adapter is ready; local development works without it)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
